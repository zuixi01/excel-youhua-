          {"name": "event_time", "title": "时间", "type": "datetime", "compare": {"mode": "datetime", "timezone": "Asia/Shanghai", "precision": "minute"}},
          {"name": "active", "title": "启用", "type": "boolean"},
          {"name": "department", "title": "部门", "type": "enum", "enum_values": ["技术部", "财务部"], "enum_aliases": {"技术": "技术部"}},
          {"name": "tags", "title": "标签", "type": "set", "compare": {"mode": "set"}},
          {"name": "payload", "title": "JSON", "type": "json", "compare": {"mode": "json"}}
