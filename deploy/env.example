POSTGRES_PASSWORD=replace-with-secret
MINIO_ROOT_USER=replace-with-secret
MINIO_ROOT_PASSWORD=replace-with-secret
EXCEL_AUDITOR_API_TOKEN=replace-with-at-least-32-random-characters
API_IMAGE=ghcr.io/example/excel-auditor-api:git-sha-required
WEB_IMAGE=ghcr.io/example/excel-auditor-web:git-sha-required
DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/excel_auditor?sslmode=verify-full
REDIS_URL=rediss://redis:6379/0
S3_BUCKET=excel-auditor
S3_ENDPOINT_URL=https://s3.example.com
S3_SERVER_SIDE_ENCRYPTION=AES256
AWS_REGION=us-east-1
STANDARD_CONNECTIONS_FILE=./connections.empty.json
STANDARD_SECRETS_DIR=./standard-secrets.empty
